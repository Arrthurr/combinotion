#!/usr/bin/env bash
set -euo pipefail

echo "Installing npm dependencies..."
time npm ci

if [[ ! -f .env.local ]]; then
  cp -- .env.example .env.local
fi

echo "Installing the Playwright Chromium runtime..."
if [[ "$(uname -s)" == "Linux" ]]; then
  time npx playwright install --with-deps chromium
else
  time npx playwright install chromium
fi

echo "Orb setup complete."
