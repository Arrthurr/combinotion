# ── Convex (from `npx convex dev` / dashboard) ──────────────────────────────
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# ── Clerk (Next.js + Convex JWT issuer) ─────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/books
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/books
# Issuer URL from Clerk → JWT Templates → Convex (also set on Convex deployment)
CLERK_JWT_ISSUER_DOMAIN=

# ── Public school-request boundary (Vercel route → Convex) ──────────────────
SCHOOL_REQUEST_SHARED_SECRET=

# ── Google Forms → Sheets intake ────────────────────────────────────────────
# Prefer single-line JSON (or a path-based secret store in production).
# Name used by this project; set the same value on Convex for scheduled intake.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_DONATION_APPLICATIONS_ID=
GOOGLE_SHEET_BOOK_REVIEWS_ID=

# ── Notion migration (optional; import scripts only) ────────────────────────
NOTION_TOKEN=
